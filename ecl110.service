[Unit]
Description=ECL110 Modbus to MQTT bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ecl110-mqtt-bridge
ExecStart=/opt/ecl110-mqtt-bridge/venv/bin/python /opt/ecl110-mqtt-bridge/ecl110_service.py
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
